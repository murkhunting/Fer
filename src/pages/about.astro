---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About me | Fer — Piloto de Drones">
  <section class="pt-32 pb-20 px-6 max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
    <div class="aspect-[3/4] rounded-2xl bg-gradient-to-br from-neutral-800 to-neutral-900 flex items-center justify-center text-7xl">
      👨‍✈️
    </div>
    <div>
      <p class="text-lime-400 uppercase tracking-[0.3em] text-sm mb-4">About me</p>
      <h1 class="text-4xl md:text-6xl font-black">SOY FER</h1>
      <p class="mt-6 text-neutral-400 text-lg">
        Piloto de drones certificado. Me especializo en fotografía, video y arquitectura aérea.
        Aquí irá tu bio real, experiencia, certificaciones y clientes.
      </p>
      <ul class="mt-8 space-y-3 text-neutral-300">
        <li>✅ Licencia AESA / EASA</li>
        <li>✅ +5 años volando</li>
        <li>✅ Seguro de responsabilidad civil</li>
      </ul>
      <a href="/contacto" class="inline-block mt-8 bg-lime-400 text-black font-semibold px-8 py-4 rounded-full">
        Trabajemos juntos
      </a>
    </div>
  </section>
</Layout>
