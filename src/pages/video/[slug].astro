---
import Layout from "../../layouts/Layout.astro";
import { projects, getBySlug } from "../../data/projects";

export async function getStaticPaths() {
  return projects
    .filter((p) => p.category === "video")
    .map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getBySlug("video", slug ?? "");
if (!project) return Astro.redirect("/video");
---

<Layout title={`${project.title} | Video — Fer`}>
  <section class="pt-32 px-6 max-w-4xl mx-auto pb-20">
    <a href="/video" class="text-sm text-neutral-500 hover:text-lime-400">← Volver a video</a>
    <h1 class="text-4xl md:text-6xl font-black mt-6">{project.title}</h1>
    <p class="text-neutral-500 mt-3">{project.location} — {project.year}</p>
    <div class="aspect-video mt-10 rounded-2xl bg-gradient-to-br from-neutral-800 to-neutral-900 flex items-center justify-center text-6xl">🎬</div>
    <p class="mt-8 text-lg text-neutral-300">{project.description}</p>
    <a href="/contacto" class="inline-block mt-10 bg-lime-400 text-black font-semibold px-8 py-4 rounded-full">Quiero algo así</a>
  </section>
</Layout>
